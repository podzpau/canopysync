<div class="promotional-block relative py-16 px-4 bg-gradient-to-r from-orange-500 to-red-500 overflow-hidden">
  <div class="relative max-w-4xl mx-auto text-center">
    <h2 class="text-4xl font-bold mb-4 text-white">
      <%= config['heading'] || 'Special Promotion' %>
    </h2>
    
    <p class="text-xl mb-8 text-white opacity-90">
      <%= config['description'] || 'Limited time offer' %>
    </p>
    
    <% if config['button_text'].present? %>
      <%= link_to config['button_text'], config['button_url'] || '#', 
          class: "inline-block px-8 py-4 bg-white text-orange-600 rounded-lg font-bold hover:bg-gray-100 transition-colors" %>
    <% end %>
  </div>
</div>
