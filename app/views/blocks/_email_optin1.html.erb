<!-- app/views/blocks/_email_optin1.html.erb -->
<div class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-center">
      
      <!-- Image Placeholder - on top for mobile/tablet, right for desktop -->
      <div class="w-full lg:w-1/2 order-1 lg:order-2">
        <div class="w-full bg-gray-300 rounded-2xl" style="height: 400px;"></div>
      </div>

      <!-- Form Content - centered on mobile/tablet, left on desktop -->
      <div class="w-full lg:w-1/2 order-2 lg:order-1 text-center lg:text-left">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          Subscribe to our newsletter
        </h2>
        <p class="text-lg text-gray-600 mb-6">
          Get the latest updates on products, deals, and exclusive offers delivered to your inbox.
        </p>
        
        <div class="flex gap-3 max-w-md mx-auto lg:mx-0">
          <input 
            type="email" 
            name="email" 
            placeholder="Enter your email" 
            required
            autocomplete="email"
            class="min-w-0 flex-auto rounded-lg bg-white px-4 py-3 text-gray-900 border border-gray-300 placeholder:text-gray-500 focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900"
          />
          <button 
            type="submit" 
            class="flex-none rounded-lg bg-gray-900 px-6 py-3 text-sm font-semibold text-white hover:bg-gray-800 transition-colors"
          >
            Subscribe
          </button>
        </div>
      </div>

    </div>

  </div>
</div>