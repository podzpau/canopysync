<style>
.overflow-x-auto::-webkit-scrollbar { display: none; }
.overflow-x-auto { scrollbar-width: none; }
</style>

<script>
(function() {
  function initCarousel() {
    const desktopCarousel = document.getElementById('desktop-carousel');
    const mobileCarousel = document.getElementById('mobile-carousel');
    const progressBar = document.getElementById('scroll-progress');
    
    function updateProgress(carousel) {
      if (!carousel || !progressBar) return;
      const scrollWidth = carousel.scrollWidth - carousel.clientWidth;
      const scrolled = carousel.scrollLeft;
      const progress = scrollWidth > 0 ? (scrolled / scrollWidth) * 100 : 0;
      progressBar.style.width = Math.min(progress, 100) + '%';
    }
    
    if (desktopCarousel) {
      desktopCarousel.addEventListener('scroll', function() {
        updateProgress(this);
      });
    }
    
    if (mobileCarousel) {
      mobileCarousel.addEventListener('scroll', function() {
        updateProgress(this);
      });
    }
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
})();
</script>
