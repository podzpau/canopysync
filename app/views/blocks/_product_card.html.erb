<!-- app/views/blocks/_product_card.html.erb -->
<div class="bg-white rounded-xl border border-black p-4 w-full max-w-sm mx-auto">
  <!-- Image Container with Call Out Badge -->
  <div class="relative mb-4">
    <div class="aspect-square bg-white rounded-xl border border-black overflow-hidden">
      <% if config['image_url'].present? %>
        <img src="<%= config['image_url'] %>" alt="Product image" class="w-full h-full object-cover" />
      <% else %>
        <div class="w-full h-full bg-gray-200 flex items-center justify-center text-gray-400 text-sm">
          No image
        </div>
      <% end %>
    </div>
    <!-- Call Out Badge -->
    <div class="absolute top-0 -left-4 bg-neutral-500 text-white text-xs font-bold px-2.5 py-1 rounded-r-sm">
      Call Out
    </div>
  </div>

  <!-- Product Type & Weight -->
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <!-- Sativa Icon (placeholder - replace with actual icon/emoji) -->
      <span class="text-sm">🌿</span>
      <span class="text-black text-xs font-light uppercase">Sativa</span>
    </div>
    <span class="text-black text-xs font-light">1g</span>
  </div>

  <!-- THC Info -->
  <div class="text-neutral-500 text-xs font-light uppercase mb-3">
    THC <span class="font-normal">25.70%</span>
  </div>

  <!-- Strain Name -->
  <h3 class="text-neutral-600 text-2xl font-semibold mb-1.5">
    Strain Name
  </h3>

  <!-- Brand Name -->
  <p class="text-neutral-500 text-sm uppercase mb-4">
    Brand Name
  </p>

  <!-- Pricing -->
  <div class="flex items-baseline gap-2 mb-4">
    <span class="text-black text-4xl font-extrabold">$39</span>
    <span class="text-neutral-500 text-sm line-through">$45</span>
  </div>

  <!-- Add to Bag Button -->
  <button class="w-full bg-zinc-300 hover:bg-zinc-400 text-zinc-800 font-bold py-2.5 px-4 rounded-2xl transition-colors">
    Add to Bag
  </button>
</div>