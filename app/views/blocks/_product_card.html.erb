<div class="py-16 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
        <%= config['heading'] || 'Flower' %>
      </h2>
      <div class="flex items-center gap-4">
        <a href="#" class="text-sm font-semibold text-gray-900 hover:text-orange-500">View All</a>
        <button class="w-10 h-10 flex items-center justify-center bg-orange-500 text-white rounded-md hover:bg-orange-600">
          ‹
        </button>
        <button class="w-10 h-10 flex items-center justify-center bg-orange-500 text-white rounded-md hover:bg-orange-600">
          ›
        </button>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% 4.times do |i| %>
        <div class="bg-white border-2 border-gray-300 rounded-2xl overflow-hidden hover:shadow-lg transition-shadow">
          <!-- Image -->
          <div class="w-full aspect-square bg-gray-100 rounded-xl m-4 mb-0"></div>

          <!-- Call Out Badge -->
          <div class="bg-gray-500 text-white text-xs font-bold px-3 py-1 mx-4 mt-4 rounded-md w-fit">
            Call Out
          </div>

          <!-- Content -->
          <div class="p-4">
            <!-- Type & Size -->
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="text-gray-600 text-sm">🌿</span>
                <span class="text-gray-600 text-xs font-light uppercase">Sativa</span>
              </div>
              <span class="text-gray-600 text-xs font-light">1g</span>
            </div>

            <!-- THC -->
            <div class="flex items-center gap-1 mb-3">
              <span class="text-gray-600 text-xs font-light uppercase">THC</span>
              <span class="text-gray-600 text-xs">25.70%</span>
            </div>

            <!-- Product Name -->
            <h3 class="text-xl font-semibold text-gray-900 mb-1">
              Strain Name
            </h3>

            <!-- Brand -->
            <p class="text-sm font-normal text-gray-600 uppercase mb-4">
              Brand Name
            </p>

            <!-- Price -->
            <div class="flex items-center gap-2 mb-4">
              <span class="text-3xl font-bold text-gray-900">$39</span>
              <span class="text-sm text-gray-500 line-through">$45</span>
            </div>

            <!-- Add to Bag Button -->
            <button class="w-full bg-gray-300 text-gray-800 font-bold py-2 rounded-full hover:bg-gray-400 transition-colors flex items-center justify-center gap-2">
              🛒 Add To Bag
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>