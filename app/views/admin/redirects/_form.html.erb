<%= form_with model: [:admin, redirect], local: true do |f| %>
  <% if redirect.errors.any? %>
    <div class="mb-5 px-4 py-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
      <ul class="list-disc list-inside space-y-0.5">
        <% redirect.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Source Path</label>
      <%= f.text_field :source_path,
            placeholder: "/old-product-page/",
            class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
      <p class="text-xs text-gray-400 mt-1">The old URL path being redirected from (include leading slash)</p>
    </div>

    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Target Path</label>
      <%= f.text_field :target_path,
            placeholder: "/product/new-slug/",
            class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
      <p class="text-xs text-gray-400 mt-1">Where the redirect sends visitors</p>
    </div>

    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Redirect Type</label>
      <%= f.select :redirect_type,
            [["301 — Permanent (passes link equity)", 301], ["302 — Temporary", 302]],
            { selected: redirect.redirect_type || 301 },
            class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    </div>

    <div class="flex items-center gap-3">
      <%= f.check_box :active,
            class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      <label class="text-sm font-medium text-gray-700">Active</label>
    </div>
  </div>

  <div class="flex items-center justify-between mt-6">
    <%= link_to "Cancel", admin_redirects_path,
          class: "text-sm text-gray-500 hover:text-gray-700",
          data: { turbo_frame: "_top" } %>
    <%= f.submit redirect.new_record? ? "Create Redirect" : "Save Changes",
          class: "px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg transition-colors cursor-pointer" %>
  </div>
<% end %>
