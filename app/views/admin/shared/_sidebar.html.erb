<%# Accepts `active` local — one of :dashboard, :page_editor, :seo, :seo_settings, :entities, :redirects %>
<% active ||= nil %>

<aside class="w-80 bg-white border-r border-gray-200 flex flex-col h-screen m-0 p-0 overflow-hidden flex-shrink-0">

  <!-- Logo -->
  <div style="padding: 1.5rem 1.5rem 2rem 1.5rem; border-bottom: 1px solid #E5E7EB; display: flex; align-items: center; justify-content: center;">
    <%= image_tag "canopylogo.svg", alt: "CanopySync", style: "height: 3.5rem; width: auto;" %>
  </div>

  <!-- Navigation -->
  <div class="flex-1 overflow-y-auto px-3 pt-6">
    <div class="space-y-1">

      <!-- Dashboard -->
      <% dash_active = active == :dashboard %>
      <%= link_to admin_dashboard_path,
            class: "flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors #{dash_active ? 'bg-gray-100' : 'text-gray-600 hover:bg-gray-50'}",
            data: { turbo_frame: "_top" } do %>
        <svg class="w-4 h-4 flex-shrink-0 <%= dash_active ? 'text-gray-700' : 'text-gray-500' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
        </svg>
        <span class="text-sm <%= dash_active ? 'font-semibold text-gray-900' : 'font-medium' %>">Dashboard</span>
      <% end %>

      <!-- Page Editor -->
      <% editor_active = active == :page_editor %>
      <%= link_to edit_admin_settings_path,
            class: "flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors #{editor_active ? 'bg-gray-100' : 'text-gray-600 hover:bg-gray-50'}",
            data: { turbo_frame: "_top" } do %>
        <svg class="w-4 h-4 flex-shrink-0 <%= editor_active ? 'text-gray-700' : 'text-gray-500' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span class="text-sm <%= editor_active ? 'font-semibold text-gray-900' : 'font-medium' %>">Page Editor</span>
      <% end %>

      <!-- SEO section divider -->
      <div class="pt-4 pb-1 px-3">
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">SEO</span>
      </div>

      <!-- SEO Overview -->
      <% seo_active = active == :seo %>
      <%= link_to admin_seo_index_path,
            class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors #{seo_active ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:bg-gray-50'}",
            data: { turbo_frame: "_top" } do %>
        <svg class="w-4 h-4 flex-shrink-0 <%= seo_active ? 'text-indigo-600' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span class="text-sm <%= seo_active ? 'font-semibold' : 'font-medium' %>">Overview</span>
      <% end %>

      <!-- Global Settings -->
      <% settings_active = active == :seo_settings %>
      <%= link_to edit_admin_seo_settings_path,
            class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors #{settings_active ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:bg-gray-50'}",
            data: { turbo_frame: "_top" } do %>
        <svg class="w-4 h-4 flex-shrink-0 <%= settings_active ? 'text-indigo-600' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="text-sm <%= settings_active ? 'font-semibold' : 'font-medium' %>">Global Settings</span>
      <% end %>

      <!-- Entities -->
      <% entities_active = active == :entities %>
      <%= link_to admin_concept_entities_path,
            class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors #{entities_active ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:bg-gray-50'}",
            data: { turbo_frame: "_top" } do %>
        <svg class="w-4 h-4 flex-shrink-0 <%= entities_active ? 'text-indigo-600' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        <span class="text-sm <%= entities_active ? 'font-semibold' : 'font-medium' %>">Entities</span>
      <% end %>

      <!-- Redirects -->
      <% redirects_active = active == :redirects %>
      <%= link_to admin_redirects_path,
            class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors #{redirects_active ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:bg-gray-50'}",
            data: { turbo_frame: "_top" } do %>
        <svg class="w-4 h-4 flex-shrink-0 <%= redirects_active ? 'text-indigo-600' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
        <span class="text-sm <%= redirects_active ? 'font-semibold' : 'font-medium' %>">Redirects</span>
      <% end %>

    </div>
  </div>

  <!-- Bottom: user + sign out -->
  <div class="border-t border-gray-200">
    <div class="px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-8 h-8 rounded-full bg-gray-300 flex-shrink-0"></div>
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900 truncate"><%= current_admin.email.split("@").first.capitalize %></div>
          <div class="text-xs text-gray-500">Admin</div>
        </div>
      </div>
      <%= link_to admin_logout_path, data: { turbo_method: :delete },
            class: "text-gray-400 hover:text-gray-600 transition-colors flex-shrink-0", title: "Sign out" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
      <% end %>
    </div>
  </div>

</aside>
