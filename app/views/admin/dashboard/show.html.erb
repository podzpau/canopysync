<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="flex h-screen overflow-hidden m-0 p-0">

  <%= render "admin/shared/sidebar", active: :dashboard %>

  <!-- ====== Main Content ====== -->
  <div class="flex-1 flex flex-col overflow-hidden bg-gray-50">

    <!-- Top bar -->
    <div class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between flex-shrink-0">
      <div>
        <h1 class="text-lg font-semibold text-gray-900">Dashboard</h1>
        <p class="text-xs text-gray-500 mt-0.5">
          <% if @period == "today" %>
            <%= Date.current.strftime("%B %-d, %Y") %>
          <% elsif @period == "week" %>
            <%= 1.week.ago.to_date.strftime("%b %-d") %> &ndash; <%= Date.current.strftime("%b %-d, %Y") %>
          <% else %>
            <%= 1.month.ago.to_date.strftime("%b %-d") %> &ndash; <%= Date.current.strftime("%b %-d, %Y") %>
          <% end %>
        </p>
      </div>

      <!-- Period filter -->
      <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-1">
        <% [["Today", "today"], ["7 days", "week"], ["30 days", "month"]].each do |label, value| %>
          <%= link_to label, admin_dashboard_path(period: value),
              class: "px-3 py-1.5 text-xs font-medium rounded-md transition-colors #{@period == value ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-700'}",
              data: { turbo_frame: "_top" } %>
        <% end %>
      </div>
    </div>

    <!-- Scrollable content -->
    <div class="flex-1 overflow-auto">
      <%= turbo_frame_tag "dashboard_content" do %>

        <div class="p-8">

          <!-- ── Row 1: 4 Metric Cards ── -->
          <div class="grid grid-cols-4 gap-6 mb-8">

            <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
              <div class="flex items-center gap-2.5 mb-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center flex-shrink-0">
                  <span class="text-emerald-600 text-xs font-bold">$</span>
                </div>
                <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">Revenue</span>
              </div>
              <div class="text-2xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(@total_revenue / 100.0, precision: 0) %></div>
              <div class="mt-1.5 text-xs text-emerald-600 font-medium">↑ 12% vs prior period</div>
            </div>

            <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
              <div class="flex items-center gap-2.5 mb-3">
                <div class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center flex-shrink-0">
                  <span class="text-indigo-600 text-xs font-bold">#</span>
                </div>
                <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">Orders</span>
              </div>
              <div class="text-2xl font-bold text-gray-900 tabular-nums"><%= number_with_delimiter(@total_orders) %></div>
              <div class="mt-1.5 text-xs text-emerald-600 font-medium">↑ 8% vs prior period</div>
            </div>

            <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
              <div class="flex items-center gap-2.5 mb-3">
                <div class="w-8 h-8 rounded-lg bg-violet-50 flex items-center justify-center flex-shrink-0">
                  <span class="text-violet-600 text-xs font-bold">≈</span>
                </div>
                <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">Avg Order</span>
              </div>
              <div class="text-2xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(@aov / 100.0, precision: 0) %></div>
              <div class="mt-1.5 text-xs text-rose-500 font-medium">↓ 3% vs prior period</div>
            </div>

            <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
              <div class="flex items-center gap-2.5 mb-3">
                <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center flex-shrink-0">
                  <span class="text-amber-600 text-xs font-bold">↗</span>
                </div>
                <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">Items Sold</span>
              </div>
              <div class="text-2xl font-bold text-gray-900 tabular-nums"><%= number_with_delimiter(@items_sold) %></div>
              <div class="mt-1.5 text-xs text-emerald-600 font-medium">↑ 15% vs prior period</div>
            </div>

          </div>

          <!-- ── Row 2: Sales Overview + Peak Hours ── -->
          <div class="grid grid-cols-5 gap-6 mb-8">

            <!-- Sales Overview (3/5) -->
            <div class="col-span-3 bg-white border border-gray-200 rounded-lg shadow-sm p-6 flex flex-col">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h3 class="text-sm font-semibold text-gray-900">Sales Overview</h3>
                  <p class="text-xs text-gray-500 mt-0.5">Revenue by day</p>
                </div>
                <select class="text-xs border border-gray-200 rounded-md px-2 py-1 text-gray-600 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500">
                  <option>Today</option>
                  <option selected>Last 7 days</option>
                  <option>Last 30 days</option>
                </select>
              </div>
              <div class="flex-1 relative min-h-[200px]">
                <canvas id="salesChart" style="width:100%;"></canvas>
              </div>
            </div>

            <!-- Peak Hours (2/5) — day × hour heatmap -->
            <div class="col-span-2 bg-white border border-gray-200 rounded-lg shadow-sm p-6">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h3 class="text-sm font-semibold text-gray-900">Peak Hours</h3>
                  <p class="text-xs text-gray-500 mt-0.5">Orders by day &amp; hour</p>
                </div>
                <select class="text-xs border border-gray-200 rounded-md px-2 py-1 text-gray-600 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500">
                  <option>Today</option>
                  <option selected>Last 7 days</option>
                  <option>Last 30 days</option>
                </select>
              </div>

              <!-- Legend -->
              <div class="flex items-center gap-3 mb-3 text-xs text-gray-400">
                <div class="flex items-center gap-1.5"><div class="w-3 h-3 rounded-sm" style="background:#4338ca"></div><span>High</span></div>
                <div class="flex items-center gap-1.5"><div class="w-3 h-3 rounded-sm" style="background:#818cf8"></div><span>Mid</span></div>
                <div class="flex items-center gap-1.5"><div class="w-3 h-3 rounded-sm" style="background:#e0e7ff"></div><span>Low</span></div>
              </div>

              <!-- Day header row: Mon–Sun -->
              <div class="flex items-center mb-1">
                <div class="shrink-0" style="width:2.75rem"></div>
                <% [["M",1],["T",2],["W",3],["T",4],["F",5],["S",6],["S",0]].each do |label, _| %>
                  <div class="flex-1 text-center text-xs font-medium text-gray-400"><%= label %></div>
                <% end %>
              </div>

              <!-- Hour rows -->
              <% (8..22).each do |hour| %>
                <div class="flex items-center mb-0.5">
                  <span class="shrink-0 text-xs text-gray-400 text-right pr-2 font-mono" style="width:2.75rem"><%= hour > 12 ? "#{hour - 12}pm" : hour == 12 ? "12pm" : "#{hour}am" %></span>
                  <% [1,2,3,4,5,6,0].each do |dow| %>
                    <% count = @peak_hours_grid.dig(dow, hour) || 0 %>
                    <% intensity = @peak_hours_max > 0 ? count.to_f / @peak_hours_max : 0 %>
                    <%
                      cell_color = if intensity > 0.75
                        "#4338ca"
                      elsif intensity > 0.5
                        "#6366f1"
                      elsif intensity > 0.25
                        "#a5b4fc"
                      elsif intensity > 0
                        "#e0e7ff"
                      else
                        "#f3f4f6"
                      end
                    %>
                    <div class="flex-1 mx-px rounded-sm" style="height:1.25rem; background:<%= cell_color %>;" title="<%= count %> orders"></div>
                  <% end %>
                </div>
              <% end %>

              <% if @peak_hours.present? %>
                <% busiest_hour, busiest_count = @peak_hours.max_by { |_, v| v } %>
                <div class="mt-3 pt-3 border-t border-gray-100 flex items-baseline gap-1.5">
                  <span class="text-xs font-semibold text-gray-900"><%= busiest_hour > 12 ? "#{busiest_hour - 12}:00 PM" : busiest_hour == 12 ? "12:00 PM" : "#{busiest_hour}:00 AM" %></span>
                  <span class="text-xs text-gray-400">busiest · <%= busiest_count %> orders</span>
                </div>
              <% end %>
            </div>

          </div>

          <!-- ── Row 3: Recent Orders + Right Column ── -->
          <div class="grid grid-cols-5 gap-6 mb-8">

            <!-- Recent Orders (3/5) -->
            <div class="col-span-3 bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
              <div class="px-6 py-4 flex items-center justify-between border-b border-gray-100">
                <h3 class="text-sm font-semibold text-gray-900">Recent Orders</h3>
                <select class="text-xs border border-gray-200 rounded-md px-2 py-1 text-gray-600 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500">
                  <option>Today</option>
                  <option selected>Last 7 days</option>
                  <option>Last 30 days</option>
                </select>
              </div>
              <table class="w-full">
                <thead>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <th class="px-6 py-3.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date &amp; Time</th>
                    <th class="px-6 py-3.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Items</th>
                    <th class="px-6 py-3.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
                    <th class="px-6 py-3.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="w-8"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <% @recent_orders.each do |order| %>
                    <tr onclick="toggleOrderDetails(<%= order.id %>)"
                        class="hover:bg-gray-50 transition-colors cursor-pointer select-none">
                      <td class="px-6 py-3.5 text-sm text-gray-700"><%= order.ordered_at.strftime("%b %-d, %I:%M %p") %></td>
                      <td class="px-6 py-3.5 text-sm text-gray-500"><%= order.item_count %></td>
                      <td class="px-6 py-3.5 text-sm font-semibold text-gray-900 tabular-nums"><%= number_to_currency(order.total_cents / 100.0) %></td>
                      <td class="px-6 py-3.5">
                        <%
                          badge_label, badge_class = case order.status
                            when "completed" then ["Completed", "text-emerald-700 bg-emerald-50"]
                            when "pending"   then ["Pending",   "text-amber-700 bg-amber-50"]
                            when "cancelled" then ["Cancelled", "text-rose-700 bg-rose-50"]
                            else                  [order.status.capitalize, "text-gray-600 bg-gray-100"]
                          end
                        %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium <%= badge_class %>">
                          <%= badge_label %>
                        </span>
                      </td>
                      <td class="px-3 py-3.5">
                        <svg id="chevron-<%= order.id %>" class="w-3.5 h-3.5 text-gray-400 transition-transform duration-200 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </td>
                    </tr>
                    <tr id="order-details-<%= order.id %>" class="hidden">
                      <td colspan="5" class="bg-gray-50 border-l-2 border-l-indigo-400">
                        <div class="px-8 py-3">
                          <% if order.order_items.any? %>
                            <table class="w-full text-xs">
                              <thead>
                                <tr class="text-gray-400 uppercase">
                                  <th class="text-left pb-2 font-medium tracking-wider">Product</th>
                                  <th class="text-left pb-2 font-medium tracking-wider">Type</th>
                                  <th class="text-left pb-2 font-medium tracking-wider">Brand</th>
                                  <th class="text-right pb-2 font-medium tracking-wider">Qty</th>
                                  <th class="text-right pb-2 font-medium tracking-wider">Unit</th>
                                  <th class="text-right pb-2 font-medium tracking-wider">Total</th>
                                </tr>
                              </thead>
                              <tbody class="divide-y divide-gray-100">
                                <% order.order_items.each do |item| %>
                                  <tr>
                                    <td class="py-1.5 font-medium text-gray-800"><%= item.product_name %></td>
                                    <td class="py-1.5 capitalize text-gray-500"><%= item.product_type %></td>
                                    <td class="py-1.5 text-gray-500"><%= item.brand_name %></td>
                                    <td class="py-1.5 text-right text-gray-700"><%= item.quantity %></td>
                                    <td class="py-1.5 text-right text-gray-700 tabular-nums"><%= number_to_currency(item.unit_price_cents / 100.0) %></td>
                                    <td class="py-1.5 text-right font-semibold text-gray-800 tabular-nums"><%= number_to_currency(item.total_cents / 100.0) %></td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          <% else %>
                            <p class="text-gray-400 text-xs">No items on this order.</p>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                  <% if @recent_orders.empty? %>
                    <tr>
                      <td colspan="5" class="px-5 py-10 text-center text-gray-400 text-sm">No orders yet</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <!-- Right column (2/5) -->
            <div class="col-span-2 space-y-6">

              <!-- Top Products -->
              <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
                <div class="px-6 py-4 flex items-center justify-between border-b border-gray-100">
                  <h3 class="text-sm font-semibold text-gray-900">Top Products</h3>
                  <select class="text-xs border border-gray-200 rounded-md px-2 py-1 text-gray-600 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500">
                    <option>Today</option>
                    <option selected>Last 7 days</option>
                    <option>Last 30 days</option>
                  </select>
                </div>
                <% if @top_products.empty? %>
                  <div class="px-6 py-8 text-center text-gray-400 text-sm">No data yet</div>
                <% else %>
                  <div class="divide-y divide-gray-100">
                    <% @top_products.each_with_index do |product, i| %>
                      <div class="px-6 py-3 flex items-center justify-between">
                        <div class="flex items-center gap-3 min-w-0">
                          <span class="text-xs font-medium text-gray-400 w-4 shrink-0"><%= i + 1 %></span>
                          <div class="min-w-0">
                            <div class="text-sm font-medium text-gray-900 truncate"><%= product.product_name %></div>
                            <div class="text-xs text-gray-500"><%= number_with_delimiter(product.total_quantity.to_i) %> sold</div>
                          </div>
                        </div>
                        <span class="text-sm font-semibold text-gray-900 ml-4 whitespace-nowrap tabular-nums"><%= number_to_currency(product.total_revenue.to_i / 100.0, precision: 0) %></span>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Top Brands -->
              <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
                <div class="px-6 py-4 flex items-center justify-between border-b border-gray-100">
                  <h3 class="text-sm font-semibold text-gray-900">Top Brands</h3>
                  <select class="text-xs border border-gray-200 rounded-md px-2 py-1 text-gray-600 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500">
                    <option>Today</option>
                    <option selected>Last 7 days</option>
                    <option>Last 30 days</option>
                  </select>
                </div>
                <% if @top_brands.empty? %>
                  <div class="px-6 py-8 text-center text-gray-400 text-sm">No data yet</div>
                <% else %>
                  <div class="divide-y divide-gray-100">
                    <% @top_brands.each_with_index do |brand, i| %>
                      <div class="px-6 py-3 flex items-center justify-between">
                        <div class="flex items-center gap-3 min-w-0">
                          <span class="text-xs font-medium text-gray-400 w-4 shrink-0"><%= i + 1 %></span>
                          <div class="text-sm font-medium text-gray-900 truncate"><%= brand.brand_name %></div>
                        </div>
                        <span class="text-sm font-semibold text-gray-900 ml-4 whitespace-nowrap tabular-nums"><%= number_to_currency(brand.total_revenue.to_i / 100.0, precision: 0) %></span>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Traffic & Analytics Placeholder -->
              <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-5 text-center">
                <div class="text-2xl mb-1.5">📊</div>
                <h3 class="text-sm font-semibold text-gray-700 mb-1">Traffic & Analytics</h3>
                <p class="text-xs text-gray-500 mb-3">Connect Google Analytics to see visitors, bounce rate, and traffic sources.</p>
                <span class="inline-block px-3 py-1 text-xs font-medium text-emerald-700 bg-emerald-50 rounded-md">Coming Soon</span>
              </div>

            </div>

          </div>

        </div>

        <!-- Chart init — inside frame so it reruns on Turbo frame updates -->
        <script>
          function toggleOrderDetails(orderId) {
            var row     = document.getElementById('order-details-' + orderId);
            var chevron = document.getElementById('chevron-' + orderId);
            if (row)     row.classList.toggle('hidden');
            if (chevron) chevron.style.transform = row && !row.classList.contains('hidden') ? 'rotate(180deg)' : '';
          }

          (function () {
            function initSalesChart() {
              if (typeof Chart === 'undefined') { setTimeout(initSalesChart, 50); return; }

              const canvas = document.getElementById('salesChart');
              if (!canvas) return;

              const existing = Chart.getChart(canvas);
              if (existing) existing.destroy();

              const labels = <%= @sales_by_day.map { |d| d.day.respond_to?(:strftime) ? d.day.strftime("%b %-d") : d.day.to_s }.to_json.html_safe %>;
              const values = <%= @sales_by_day.map { |d| (d.revenue.to_f / 100).round(2) }.to_json.html_safe %>;

              new Chart(canvas, {
                type: 'bar',
                data: {
                  labels: labels,
                  datasets: [{
                    data: values,
                    backgroundColor: '#6366f1',
                    borderRadius: { topLeft: 3, topRight: 3 },
                    borderSkipped: 'bottom',
                    barPercentage: 0.75,
                    categoryPercentage: 0.85
                  }]
                },
                options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  layout: { padding: { left: 0, right: 0, top: 4, bottom: 0 } },
                  plugins: {
                    legend: { display: false },
                    tooltip: {
                      callbacks: {
                        label: ctx => '$' + ctx.parsed.y.toLocaleString('en-US', { maximumFractionDigits: 0 })
                      }
                    }
                  },
                  scales: {
                    x: {
                      grid: { display: false },
                      ticks: { font: { size: 11 }, color: '#6B7280', maxTicksLimit: 14 }
                    },
                    y: {
                      grid: { color: '#F3F4F6' },
                      border: { dash: [3, 3], display: false },
                      ticks: {
                        font: { size: 11 },
                        color: '#9CA3AF',
                        callback: v => '$' + v.toLocaleString()
                      }
                    }
                  }
                }
              });
            }

            initSalesChart();
          })();
        </script>

      <% end %>
    </div>

  </div>

</div>