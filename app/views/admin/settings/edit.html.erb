              <%= f.submit 'Save Brand', class: 'w-full mt-3 px-4 py-2 bg-orange-500 hover:bg-orange-600 text-gray-800 text-xs rounded transition-colors font-medium' %>
            </div>
          <% end %>
        </div>
      </details>
    </div>
    
  </div>
  <!-- End Scrollable Content Area -->

  <!-- Bottom Section - Fixed to bottom -->
  <div class="mt-auto border-t border-gray-200">
    <!-- User Profile -->
    <div class="px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div style="width: 40px; height: 40px; background-color: #9CA3AF; border-radius: 9999px; flex-shrink: 0;"></div>
        <div>
          <div class="text-sm font-medium text-gray-900">Evano</div>
          <div class="text-xs text-gray-500">Manager</div>
        </div>
      </div>
      <button class="text-gray-400 hover:text-gray-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
    </div>
    
    <!-- Back to Dashboard -->
    <div class="px-6 py-4 flex justify-center">
      <%= link_to root_path, class: 'flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors' do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span class="text-sm underline">Back to Dashboard</span>
      <% end %>
    </div>
  </div>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('aside details').forEach(detail => {
        const chevronRight = detail.querySelector('summary svg.chevron-right');
        const chevronBlocks = detail.querySelector('summary svg.chevron-blocks');
        
        const toggleDetail = () => {
          if (detail.open) {
            detail.style.backgroundColor = '#F5F5F5';
            if (chevronRight) chevronRight.style.transform = 'rotate(90deg)';
            if (chevronBlocks) chevronBlocks.style.transform = 'rotate(90deg)';
          } else {
            detail.style.backgroundColor = 'transparent';
            if (chevronRight) chevronRight.style.transform = 'rotate(0deg)';
            if (chevronBlocks) chevronBlocks.style.transform = 'rotate(0deg)';
          }
        };
        
        detail.addEventListener('toggle', toggleDetail);
        toggleDetail();
      });
    });
  </script>
  
</aside>

<!-- Right Side: Canvas Area -->
<div class="flex-1 flex flex-col bg-gray-50">
  
  <!-- Device Selector Toolbar -->
  <div class="bg-white border-b border-gray-200 px-6 py-4">
    <div class="flex items-center gap-2">
      <button data-device="desktop" class="device-btn active flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <span>Desktop</span>
        <span class="text-xs text-gray-500">1440px</span>
      </button>
      
      <button data-device="tablet" class="device-btn flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
        <span>Tablet</span>
        <span class="text-xs text-gray-500">744px</span>
      </button>
      
      <button data-device="mobile" class="device-btn flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
        <span>Mobile</span>
        <span class="text-xs text-gray-500">390px</span>
      </button>
    </div>
  </div>
  
  <!-- Canvas Workspace -->
  <div class="flex-1 overflow-auto p-4 bg-gray-50" style="height: calc(100vh - 80px);">
    <div class="mx-auto" id="preview-container" style="transition: all 0.3s;">
      <iframe 
        id="preview-frame"
        src="<%= preview_admin_settings_path %>"
        style="
          width: 1440px;
          height: 100%;
          min-height: 900px;
          border: none;
          background: white;
          box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
          transition: all 0.3s;
          margin: 0 auto;
          display: block;
        "
      ></iframe>
    </div>
  </div>
  
</div>

</div>

<style>
  body {
    margin: 0;
    padding: 0;
  }
  
  .device-btn {
    background: white;
    border: 1px solid #E5E7EB;
    color: #6B7280;
  }
  .device-btn.active {
    background: #F97316;
    color: #1F2937;
    border-color: #F97316;
  }
  .device-btn.active .text-gray-500 {
    color: #4B5563;
  }
  .device-btn:hover:not(.active) {
    background: #F9FAFB;
    border-color: #D1D5DB;
  }
</style>

<script>
  function initDevicePreview() {
    const iframe = document.getElementById('preview-frame');
    const buttons = document.querySelectorAll('.device-btn');
    
    if (!iframe) {
      console.error('Preview iframe not found!');
      return;
    }
    
    const widths = {
      desktop: '1440px',
      tablet: '744px',
      mobile: '390px'
    };
    
    buttons.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const device = this.dataset.device;
        
        buttons.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        iframe.style.width = widths[device];
      });
    });
  }
  
  document.addEventListener('DOMContentLoaded', initDevicePreview);
  document.addEventListener('turbo:load', initDevicePreview);
  
  if (document.readyState !== 'loading') {
    initDevicePreview();
  }
</script>