<?xml version="1.0" encoding="UTF-8"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <% @segments.each do |segment| %>
  <sitemap>
    <loc><%= segment[:loc] %></loc>
    <% if segment[:lastmod] %>
    <lastmod><%= segment[:lastmod].utc.strftime("%Y-%m-%d") %></lastmod>
    <% end %>
  </sitemap>
  <% end %>
</sitemapindex>
